#!/usr/bin/env python3
"""Format and validate commit messages.

Standard (docs/commit-style.md):
- Subject: imperative sentence, at most 72 characters, no trailing period, no emoji.
  fixup!, squash!, amend!, Merge and Revert subjects are accepted unchanged.
- One blank line between subject and body.
- Body prose and bullets wrap at 72 columns; continuations use two spaces.
  Indented lines, fenced code and lines containing a URL are left alone.
- No Co-Authored-By, Signed-off-by, Reviewed-by, Acked-by or Change-Id trailers.
"""

import re
import sys
import textwrap

WIDTH = 72
EMOJI = re.compile("[\U0001F000-\U0001FAFF\u2600-\u27BF]")
TRAILER = re.compile(r"^(Co-Authored-By|Signed-off-by|Reviewed-by|Acked-by|Change-Id):", re.I)
SUBJECT_PREFIX = re.compile(r"^(fixup!|squash!|amend!|Merge |Revert )")
URL = re.compile(r"https?://")


def fail(message):
    print(f"commit-msg: {message}", file=sys.stderr)
    print("commit-msg: see docs/commit-style.md", file=sys.stderr)
    sys.exit(1)


def wrap_block(lines, indent="", width=WIDTH):
    text = " ".join(line.strip() for line in lines)
    return textwrap.wrap(
        text,
        width=width,
        initial_indent=indent,
        subsequent_indent=indent,
        break_long_words=False,
        break_on_hyphens=False,
    ) or [indent.rstrip()]


def format_body(body):
    out = []
    index = 0
    in_fence = False
    while index < len(body):
        line = body[index].rstrip()
        if line.strip().startswith("```"):
            in_fence = not in_fence
            out.append(line)
            index += 1
            continue
        if in_fence or line.startswith((" ", "\t")) or line.startswith("#"):
            out.append(line)
            index += 1
            continue
        if line == "":
            if out and out[-1] != "":
                out.append("")
            index += 1
            continue
        if line.startswith("- "):
            block = [line[2:].strip()]
            index += 1
            while (
                index < len(body)
                and body[index].startswith("  ")
                and not body[index].startswith("  - ")
                and body[index].strip()
            ):
                block.append(body[index].strip())
                index += 1
            wrapped = wrap_block(block, width=WIDTH - 2)
            out.append("- " + wrapped[0])
            out.extend("  " + continuation for continuation in wrapped[1:])
            continue
        block = [line]
        index += 1
        while (
            index < len(body)
            and body[index].strip()
            and not body[index].startswith((" ", "\t", "- ", "```", "#"))
        ):
            block.append(body[index].rstrip())
            index += 1
        if any(URL.search(entry) for entry in block):
            out.extend(entry.strip() for entry in block)
        else:
            out.extend(wrap_block(block))
    while out and out[-1] == "":
        out.pop()
    return out


def main():
    if len(sys.argv) != 2:
        fail("expected the commit message path")
    path = sys.argv[1]
    try:
        with open(path, "r", encoding="utf-8") as handle:
            raw = handle.read()
    except (OSError, UnicodeDecodeError) as error:
        fail(f"cannot read the message: {error}")

    lines = [line.rstrip() for line in raw.replace("\r\n", "\n").replace("\r", "\n").split("\n")]
    while lines and lines[-1] == "":
        lines.pop()
    if not lines or not lines[0].strip():
        fail("the subject must not be empty")

    subject = lines[0].strip()
    body = lines[1:]

    if EMOJI.search(subject):
        fail("the subject must not contain emoji")
    if len(subject) > WIDTH:
        fail(f"the subject is {len(subject)} characters; keep it at most {WIDTH}")
    if subject.endswith("."):
        fail("the subject must not end with a period")
    if not SUBJECT_PREFIX.match(subject) and not subject[0].isupper():
        fail("the subject must start with an uppercase word")

    if body:
        if body[0] != "":
            fail("put one blank line between the subject and the body")
        while body and body[0] == "":
            body.pop(0)
        for line in body:
            if TRAILER.match(line.strip()):
                fail(f"remove the trailer: {line.strip()}")
            if EMOJI.search(line):
                fail("the body must not contain emoji")

    formatted_body = format_body(body)
    for line in formatted_body:
        if len(line) > WIDTH and not line.startswith((" ", "\t")) and not URL.search(line):
            fail(f"body line exceeds {WIDTH} characters: {line}")

    message = subject + ("\n\n" + "\n".join(formatted_body) if formatted_body else "") + "\n"
    with open(path, "w", encoding="utf-8") as handle:
        handle.write(message)


if __name__ == "__main__":
    main()
