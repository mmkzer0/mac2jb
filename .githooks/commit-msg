#!/usr/bin/env python3
"""Format and validate commit messages.

Standard (docs/commit-style.md):
- Subject: imperative sentence, at most 72 characters, no trailing period, no emoji.
  fixup!, squash!, amend!, Merge and Revert subjects are accepted unchanged
  (only the trailer ban still applies).
- One blank line between subject and body.
- Body prose and bullets wrap at 72 columns; continuations use two spaces.
  Indented lines, fenced code and lines containing a URL are left alone.
- No Co-Authored-By, Signed-off-by, Reviewed-by, Acked-by or Change-Id trailers.

git runs this hook before its own cleanup, so the editor template is still in
the file: lines starting with the comment character are kept verbatim and are
never validated, and everything from the scissors line (git commit -v) to the
end of the file is written back byte for byte.
"""

import re
import subprocess
import sys
import textwrap

WIDTH = 72
EMOJI = re.compile("[\U0001F000-\U0001FAFF\u2600-\u27BF]")
TRAILER = re.compile(r"^(Co-Authored-By|Signed-off-by|Reviewed-by|Acked-by|Change-Id):", re.I)
SUBJECT_PREFIX = re.compile(r"^(fixup!|squash!|amend!|Merge |Revert )")
URL = re.compile(r"https?://")
SCISSORS = " ------------------------ >8 ------------------------"


def fail(message):
    print(f"commit-msg: {message}", file=sys.stderr)
    print("commit-msg: see docs/commit-style.md", file=sys.stderr)
    sys.exit(1)


def comment_char():
    for key in ("core.commentString", "core.commentChar"):
        try:
            result = subprocess.run(
                ["git", "config", "--get", key], capture_output=True, text=True
            )
        except OSError:
            return "#"
        value = result.stdout.rstrip("\n") if result.returncode == 0 else ""
        if value and value != "auto":
            return value
    return "#"


def wrap_block(lines, indent="", width=WIDTH):
    text = " ".join(line.strip() for line in lines)
    return textwrap.wrap(
        text,
        width=width,
        initial_indent=indent,
        subsequent_indent=indent,
        break_long_words=False,
        break_on_hyphens=False,
    ) or [indent.rstrip()]


def format_body(body, cc):
    out = []
    index = 0
    in_fence = False
    while index < len(body):
        if body[index].startswith(cc):
            out.append(body[index])
            index += 1
            continue
        line = body[index].rstrip()
        if line.strip().startswith("```"):
            in_fence = not in_fence
            out.append(line)
            index += 1
            continue
        if in_fence or line.startswith((" ", "\t")):
            out.append(line)
            index += 1
            continue
        if line == "":
            if out and out[-1] != "":
                out.append("")
            index += 1
            continue
        if line.startswith("- "):
            block = [line[2:].strip()]
            index += 1
            while (
                index < len(body)
                and body[index].startswith("  ")
                and not body[index].startswith("  - ")
                and body[index].strip()
            ):
                block.append(body[index].strip())
                index += 1
            wrapped = wrap_block(block, width=WIDTH - 2)
            out.append("- " + wrapped[0])
            out.extend("  " + continuation for continuation in wrapped[1:])
            continue
        block = [line]
        index += 1
        while (
            index < len(body)
            and body[index].strip()
            and not body[index].startswith((" ", "\t", "- ", "```", cc))
        ):
            block.append(body[index].rstrip())
            index += 1
        if any(URL.search(entry) for entry in block):
            out.extend(entry.strip() for entry in block)
        else:
            out.extend(wrap_block(block))
    while out and out[-1] == "":
        out.pop()
    return out


def main():
    if len(sys.argv) != 2:
        fail("expected the commit message path")
    path = sys.argv[1]
    try:
        with open(path, "rb") as handle:
            data = handle.read()
    except OSError as error:
        fail(f"cannot read the message: {error}")

    cc = comment_char()
    scissors = re.search(b"^" + re.escape((cc + SCISSORS).encode("utf-8")), data, re.M)
    tail = b""
    if scissors:
        data, tail = data[: scissors.start()], data[scissors.start() :]
    try:
        raw = data.decode("utf-8")
    except UnicodeDecodeError as error:
        fail(f"cannot read the message: {error}")

    lines = raw.replace("\r\n", "\n").replace("\r", "\n").split("\n")
    lines = [line if line.startswith(cc) else line.rstrip() for line in lines]
    while lines and lines[-1] == "":
        lines.pop()

    subject_index = next(
        (i for i, line in enumerate(lines) if line.strip() and not line.startswith(cc)), None
    )
    if subject_index is None:
        # Nothing but template comments: git itself aborts on the empty message.
        return
    prefix = lines[:subject_index]
    subject = lines[subject_index].strip()
    body = lines[subject_index + 1 :]
    message_body = [line for line in body if not line.startswith(cc)]

    for line in message_body:
        if TRAILER.match(line.strip()):
            fail(f"remove the trailer: {line.strip()}")

    if SUBJECT_PREFIX.match(subject):
        return

    if EMOJI.search(subject):
        fail("the subject must not contain emoji")
    if len(subject) > WIDTH:
        fail(f"the subject is {len(subject)} characters; keep it at most {WIDTH}")
    if subject.endswith("."):
        fail("the subject must not end with a period")
    if not subject[0].isupper():
        fail("the subject must start with an uppercase word")

    if message_body:
        if message_body[0] != "":
            fail("put one blank line between the subject and the body")
        for line in message_body:
            if EMOJI.search(line):
                fail("the body must not contain emoji")

    leading_blank = bool(body) and body[0] == ""
    formatted_body = format_body(body, cc)
    for line in formatted_body:
        if (
            len(line) > WIDTH
            and not line.startswith(cc)
            and not line.startswith((" ", "\t"))
            and not URL.search(line)
        ):
            fail(f"body line exceeds {WIDTH} characters: {line}")
    if leading_blank and formatted_body:
        formatted_body.insert(0, "")

    message = "\n".join(prefix + [subject] + formatted_body) + "\n"
    with open(path, "wb") as handle:
        handle.write(message.encode("utf-8") + tail)


if __name__ == "__main__":
    main()
